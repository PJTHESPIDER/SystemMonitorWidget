<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.

The TargetFramework is deliberately not set here. It is declared once, by
the project file, and overriding it in a profile is how the ARM64 profile
used to end up with a TargetPlatformVersion below the project's
10.0.22000.0 requirement, failing the build with NETSDK1135.

GenerateAppxPackageOnBuild is left off. The package is produced by
build/Create-TestMsix.ps1, which controls the manifest rewrite, the
architecture and the signing. A profile that also generated a package
would produce a second, unsigned, differently-shaped package.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>

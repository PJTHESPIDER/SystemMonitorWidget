<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.

The TargetFramework is deliberately not set here. This profile used to
override it with net8.0-windows10.0.19041.0, which lowered the effective
TargetPlatformVersion below the project's 10.0.22000.0 and made the ARM64
build fail with NETSDK1135. The project itself declares the target
framework, so the profile only needs to name the architecture.

The Platform was x64 here, which contradicted the RuntimeIdentifier. It is
now ARM64, matching the platform this profile publishes for.

See win-x64.pubxml for why GenerateAppxPackageOnBuild is not set.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>ARM64</Platform>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <TargetPlatformVersion>10.0.22000.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>System_Monitor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      The manifest lives in a nested folder relative to this project file.
      The path below is relative to the project directory, so it must
      include the nested folder name. It previously read
      "Package.appxmanifest", which resolved to a file that does not exist
      and had never existed in this repository's history.
    -->
    <AppxManifest>SystemMonitor\Package.appxmanifest</AppxManifest>
    <!--
      The architectures this project is built and published for. All three
      are build-tested; see docs/build-and-package.md for the exact
      commands and for which parts of the matrix are Windows-only.
    -->
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!--
      Only resolve a publish profile when the platform actually names one.
      The default AnyCPU platform has no profile, and asking for
      "win-AnyCPU.pubxml" produced a NETSDK1198 warning on every publish.
    -->
    <PublishProfile Condition="'$(Platform)' != 'AnyCPU'">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>false</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSDKBootstrapInitialize>false</WindowsAppSDKBootstrapInitialize>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <AppxManifestFile Include="SystemMonitor\Package.appxmanifest" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!--
      Pinned to 10.0.2 because LibreHardwareMonitorLib 0.9.6 requires
      System.Management >= 10.0.2; NuGet errors on the resulting downgrade.
      The 10.0.2 package still ships a net8.0 asset, so the target framework
      is unaffected.
    -->
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageReference Include="System.Security.Permissions" Version="8.0.0" />
    <!--
      Read-only hardware sensor backend. MPL-2.0. Fully managed: the package
      ships no native binaries or drivers. See docs/refactor-plan.md for the
      exact version, transitive dependency list and known limitations.
    -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Models\**\*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="..\Services\**\*.cs" Link="Services/%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">False</PublishTrimmed>
    <PackageId>com.test.systemmonitor</PackageId>
    <Title>System Monitor</Title>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="SystemMonitor\Package.appxmanifest" />
  </ItemGroup>
</Project>
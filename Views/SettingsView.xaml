<UserControl
    x:Class="System_Monitor.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="380" Height="280">
    <StackPanel Padding="12" Spacing="8">
        <TextBlock Text="Widget Settings" FontWeight="SemiBold" FontSize="14"/>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <CheckBox Content="CPU" IsChecked="{Binding ShowCpu}" />
            <CheckBox Content="GPU" IsChecked="{Binding ShowGpu}" />
            <CheckBox Content="RAM" IsChecked="{Binding ShowRam}" />
            <CheckBox Content="Disk" IsChecked="{Binding ShowDisk}" />
            <CheckBox Content="Network" IsChecked="{Binding ShowNetwork}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
            <TextBlock Text="Refresh (s)" VerticalAlignment="Center"/>
            <TextBox Width="60" Text="{Binding RefreshIntervalSeconds, Mode=TwoWay}" />
        </StackPanel>

        <TextBlock Text="Changes apply immediately." FontSize="12" Opacity="0.7"/>
    </StackPanel>
</UserControl>
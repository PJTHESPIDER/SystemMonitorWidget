<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    The pipeline tests use the FakeTimeProvider from
    Microsoft.Extensions.TimeProvider.Testing (see the PackageReference below).
    A hand-rolled local copy used to live here and shadowed the package type
    in the SystemMonitor.Tests namespace, so the tests were silently running
    against the local implementation instead of the packaged one.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <!-- FakeTimeProvider gives the pipeline tests virtual time, so polling
         intervals are advanced deterministically instead of slept through. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
    <!-- Required for SystemMetricsService integration tests -->
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageReference Include="System.Security.Permissions" Version="8.0.0" />
    <!-- Required because SystemMetricsService references LibreHardwareMonitorSource internally;
         the tests inject a fake ILhmSensorSource but the type still needs to resolve at compile time. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <!-- Link the production logic without the Windows App SDK host. The
       LibreHardwareMonitor adapter is linked because SystemMetricsService's
       production constructor references it; integration tests inject a fake
       ILhmSensorSource, so the adapter does not open real hardware in tests.
       Its package reference is therefore a compile-time dependency of the
       linked production source, not a hardware test backend. -->
  <ItemGroup>
    <Compile Include="../Models/HardwareModels.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../Models/SystemMetrics.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../Services/ThermalMath.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/NetworkDeltaCalculator.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/NetworkInterfacePolicy.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/LegacyPayloadPresenter.cs" Link="Services/%(Filename)%(Extension)" />
    <!--
      The diagnostic subsystem. It is pure logic over a TimeProvider and an
      injectable sink, so the rate limiting, the scrubbing and the
      availability explanations can all be tested without touching the
      hardware or the filesystem.
    -->
    <Compile Include="../Services/ByteFormatter.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/Diagnostics.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/SensorAvailability.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/DiagnosticInventory.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/DiagnosticHost.cs" Link="Services/%(Filename)%(Extension)" />
    <!--
      The manufacturer-neutral widget payload. The presenter, the selection
      policy, the payload container and the templates are pure logic: they
      format an immutable snapshot and bind it to a template, and they never
      touch the widget host or the hardware. The templates use the project's
      own WidgetLayoutSize enum rather than the Windows App SDK's
      WidgetSize, so the real templates can be linked and asserted on
      directly.
    -->
    <Compile Include="../Services/GpuSelectionPolicy.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/SystemMetricsService.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/GpuService.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/ScalarCollectorState.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/ScalarCandidate.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/ScalarMergePolicy.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/NvidiaGpuFallback.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/NvidiaGpuFallbackPolicy.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/NvidiaGpuReconciler.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/NvidiaGpuIdentity.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/NvidiaGpuSample.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/NvidiaSmiParser.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/NvidiaSmiLocator.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/IProcessRunner.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/SystemProcessRunner.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/NvidiaGpuFallbackSelector.cs" Link="Services/%(Filename)%(Extension)" />
    <!--
      The policies that decide whether an unattributed reading may be
      presented, and whether a failed read may be presented as a value.
      Both are pure decisions, so they are exercised directly.
    -->
    <Compile Include="../Services/GpuMemoryFallbackPolicy.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/GpuMemoryCompatibilityPolicy.cs" Link="Services/%(Filename)%(Extension)" />
    <!--
      The GPU-memory presentation. It resolves a memory figure and the
      heading it is shown under together, so the heading cannot claim a
      memory pool the reading did not establish. It is pure formatting
      over a measurement, so it is exercised directly.
    -->
    <Compile Include="../Services/GpuMemoryPresentation.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/WidgetLayoutSize.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/WidgetPayload.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/WidgetPayloadPresenter.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/WidgetTemplates.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/LhmSensorSelection.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/LhmSensorSource.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/LhmSnapshotMapper.cs" Link="Services/%(Filename)%(Extension)" />
    <!--
      The sensor diagnostics: the trace of what the selection saw and the
      policy that turns that trace into a diagnosis. Both are pure logic
      over the selection's own types, so the six distinguishable causes of
      an unavailable figure can be exercised without hardware.
    -->
    <Compile Include="../Services/LhmSensorDiagnostics.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/LhmRetainedSensorPolicy.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/GpuSelectionTracker.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/GpuExtrasTracker.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/IMetricsCollector.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/UpdatePipeline.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/WidgetRegistry.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Services/LibreHardwareMonitorSource.cs" Link="Services/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
